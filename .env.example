# Copy this file to .env and fill in real values. Never commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: use guild-scoped command registration for faster development.
DISCORD_GUILD_ID=

# Set DATABASE_URL or provide all POSTGRES_* values below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=exiverse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Set to true only when your PostgreSQL provider requires verified TLS.
POSTGRES_SSL=false
